{
    "manifest_version": 3,
    "name": "QuickLinker",
    "version": "2.0.1",
    "permissions": [
      "contextMenus",
      "storage",
      "activeTab",
      "scripting"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html"
    },
    "icons": {
      "16": "icons/icon16.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png",
      "256": "icons/icon256.png",
      "512": "icons/icon512.png"
    },
    "description": "QuickLinker is a browser extension that allows you to quickly create and manage links to your favorite websites.",
    "content_scripts": [
      {
        "matches": ["*://*.javdb.com/*"],
        "css": ["content.css"],
        "js": ["content.js"]
      }
    ]
  }